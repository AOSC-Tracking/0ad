                </object>
                <object name="narrativeOverlayNextButton" type="button" style="BrownButton" size="70%-80 22 70%+80 54">
                    <object type="image" sprite="stretched:session/narrative_overlay/button_glow.png" size="50%-128 50%-64 50%+128 50%+64" ghost="true"/>
                </object>
            </object>
        </object>
