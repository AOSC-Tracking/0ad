{
    "compilerOptions": {
        "target": "es2023",
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "declarationMap": true,
        "declaration": true,
        "strict": true,
        "noImplicitThis": true,
        "lib": [
            "ESNext"
        ]
    },
    "include": [
        "../../mod/types/pyrogenesis.d.ts",
        "types/*.d.ts",
        "types/components/*.d.ts",
        "../globalscripts/types/*d.ts",

        "../../mod/globalscripts/*.js",
        "../globalscripts/*.js",
        "helpers/*.js",
        "components/*.js",
    ]
}
