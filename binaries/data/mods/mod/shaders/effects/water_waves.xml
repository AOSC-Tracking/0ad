<?xml version="1.0" encoding="utf-8"?>
<effect>
	<technique>
		<require shaders="glsl"/>
		<pass shader="glsl/waves">
			<depth test="TRUE" func="always"/>
			<blend src="src_alpha" dst="one"/>
		</pass>
	</technique>

	<technique>
		<require shaders="spirv"/>
		<pass shader="spirv/waves">
			<depth test="TRUE" func="always"/>
			<blend src="src_alpha" dst="one"/>
		</pass>
	</technique>
</effect>
