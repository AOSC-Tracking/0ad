+void Surface::fromLogScale(int channel, float base) {
+    if (isNull()) return;
+
+    detach();
+
+    FloatImage * img = m->image;
+    float * c = img->channel(channel);
+
+    float scale = log2f(base);
+
+    const uint count = img->pixelCount();
+    for (uint i = 0; i < count; i++) {
+        c[i] = exp2f(c[i] * scale);
+    }
+}
