+    // That is:
+    // - 'DXT1' is a format 'DXT1a' and 'DXT1n' are DXT1 compressors.
+    // - 'DXT3' is a format 'DXT3n' is a DXT3 compressor.
+    // Having multiple enums for the same ids only creates confusion. Clean this up.
+    enum Format
