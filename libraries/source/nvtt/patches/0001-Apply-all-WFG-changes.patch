+        explicit Atomic()  : m_value() { }
+        explicit Atomic( T val ) : m_value(val) { }
+        ~Atomic() { }
+
+        T loadRelaxed()  const { return m_value; }
+        void storeRelaxed(T val) { m_value = val; }
