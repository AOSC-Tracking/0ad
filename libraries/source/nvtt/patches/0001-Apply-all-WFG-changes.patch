+// Draw colored border.
+void Surface::setBorder(float r, float g, float b, float a)
+{
+    if (isNull()) return;
+
+    detach();
+
+    FloatImage * img = m->image;
+    const uint w = img->width();
+    const uint h = img->height();
+    const uint d = img->depth();
+
+    for (uint z = 0; z < d; z++)
+    {
+        for (uint i = 0; i < w; i++)
+        {
+            img->pixel(0, i, 0, z) = r;
+            img->pixel(1, i, 0, z) = g;
+            img->pixel(2, i, 0, z) = b;
+            img->pixel(3, i, 0, z) = a;
+
+            img->pixel(0, i, h-1, z) = r;
+            img->pixel(1, i, h-1, z) = g;
+            img->pixel(2, i, h-1, z) = b;
+            img->pixel(3, i, h-1, z) = a;
+        }
+
+        for (uint i = 0; i < h; i++)
+        {
+            img->pixel(0, 0, i, z) = r;
+            img->pixel(1, 0, i, z) = g;
+            img->pixel(2, 0, i, z) = b;
+            img->pixel(3, 0, i, z) = a;
+
+            img->pixel(0, w-1, i, z) = r;
+            img->pixel(1, w-1, i, z) = g;
+            img->pixel(2, w-1, i, z) = b;
+            img->pixel(3, w-1, i, z) = a;
+        }
+    }
