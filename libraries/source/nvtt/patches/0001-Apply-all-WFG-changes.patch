+bool ColorSet::isSingleColor(bool ignoreAlpha) const
+{
+    Vector4 v = colors[0];
+    if (ignoreAlpha) v.w = 1.0f;
+
+    for (uint i = 1; i < colorCount; i++)
+    {
+        Vector4 c = colors[i];
+        if (ignoreAlpha) c.w = 1.0f;
+
+        if (v != c) {
+            return false;
+        }
+    }
+
+    return true;
+}
