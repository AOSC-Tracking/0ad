-    const float kH = 1;
-    const float k1 = 0.045f;
-    const float k2 = 0.015f;
-
-    const float sL = 1;
-
-    const float * r0 = img0->channel(0);
-    const float * g0 = img0->channel(1);
-    const float * b0 = img0->channel(2);
