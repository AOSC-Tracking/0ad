+void BlockDXT3::flip4()
+{
+    alpha.flip4();
+    color.flip4();
+}
+
+/// Flip half DXT3 block vertically.
+void BlockDXT3::flip2()
+{
+    alpha.flip2();
+    color.flip2();
+}
