+void OptimalCompress::compressDXT3A(const ColorBlock & src, AlphaBlockDXT3 * dst)
+{
+    AlphaBlock4x4 tmp;
+    tmp.init(src, 3);
+    compressDXT3A(tmp, dst);
+}
