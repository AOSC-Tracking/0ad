-static void read_indices(Bits &in, int shapeindex, int indices[Tile::TILE_H][Tile::TILE_W])
-{
-	// the index we shorten is always index 0
-	for (int i = 0; i < Tile::TILE_TOTAL; ++i)
-	{
-		if (i==0)
