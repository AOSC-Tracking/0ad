-#define	R_0(ep)	(ep)[0].A[i]
-#define	R_1(ep)	(ep)[0].B[i]
-#define	R_2(ep)	(ep)[1].A[i]
-#define	R_3(ep)	(ep)[1].B[i]
-#define	MASK(n)	((1<<(n))-1)
