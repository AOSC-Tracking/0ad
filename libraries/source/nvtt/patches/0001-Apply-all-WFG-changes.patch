-    uint indices = 0;
-	for (int i = 0; i < 16; i++) {
-		float d0 = evaluate_mse(palette[0], input_colors[i].xyz(), color_weights);
-		float d1 = evaluate_mse(palette[1], input_colors[i].xyz(), color_weights);
-		float d2 = evaluate_mse(palette[2], input_colors[i].xyz(), color_weights);
