+/** Append a string. */
+StringBuilder & StringBuilder::append(const char * s, uint len)
+{
+    nvDebugCheck(s != NULL);
+
+	uint offset = length();
+	const uint size = offset + len + 1;
+	reserve(size);
+	strCpy(m_str + offset, len + 1, s, len);
+
+    return *this;
+}
