-static void transform_forward(int transform_mode, IntEndptsRGBA ep[NREGIONS])
-{
-	int i;
-
-	if (transform_mode & TRANSFORM_MODE_RGB)
-		for (i=CHANNEL_R; i<CHANNEL_A; ++i)
-			R_1 -= R_0;
-	if (transform_mode & TRANSFORM_MODE_ALPHA)
-	{
-		i = CHANNEL_A;
-		R_1 -= R_0;
-	}
-}
