-                t = endpts[region].A[i]; endpts[region].A[i] = endpts[region].B[i]; endpts[region].B[i] = t;
-            }
-
-            for (int y = 0; y < Tile::TILE_H; y++)
-                for (int x = 0; x < Tile::TILE_W; x++)
