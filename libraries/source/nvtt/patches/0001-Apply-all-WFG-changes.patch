+static Color32 toRgbe8(float r, float g, float b)
+{
+    Color32 c;
+    float v = max(max(r, g), b);
+    if (v < 1e-32) {
+        c.r = c.g = c.b = c.a = 0;
+    }
+    else {
+        int e;
+        v = frexp(v, &e) * 256.0f / v;
+        c.r = uint8(clamp(r * v, 0.0f, 255.0f));
+        c.g = uint8(clamp(g * v, 0.0f, 255.0f));
+        c.b = uint8(clamp(b * v, 0.0f, 255.0f));
+        c.a = e + 128;
+    }
+
+    return c;
+}
