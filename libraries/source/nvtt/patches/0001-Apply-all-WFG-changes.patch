+/// Flip CTX1 block vertically.
+inline void BlockCTX1::flip4()
+{
+    swap(row[0], row[3]);
+    swap(row[1], row[2]);
+}
+
+/// Flip half CTX1 block vertically.
+inline void BlockCTX1::flip2()
+{
+    swap(row[0], row[1]);
+}
