-static float toXenonSrgb(float f) {
-    if (f < 0)                  f = 0;
-    else if (f < (1.0f/16.0f))  f = 4.0f * f;
-    else if (f < (1.0f/8.0f))   f = 0.25f  + 2.0f * (f - 0.0625f);
-    else if (f < 0.5f)          f = 0.375f + 1.0f * (f - 0.125f);
-    else if (f < 1.0f)          f = 0.75f  + 0.5f * (f - 0.50f);
-    else                        f = 1.0f;
-    return f;
-}
