+            return ::pixelSize((D3DFORMAT)pf.fourcc);
+        }
+        else {
+            nvDebugCheck((pf.flags & DDPF_RGB) || (pf.flags & DDPF_LUMINANCE));
+            return pf.bitcount;
+        }
+    }
