+
+static Color16 truncate_color32_to_color16(Color32 c32) {
+    Color16 c16;
+    c16.b = (c32.b >> 3);
+    c16.g = (c32.g >> 2);
+    c16.r = (c32.r >> 3);
+    return c16;
+}
