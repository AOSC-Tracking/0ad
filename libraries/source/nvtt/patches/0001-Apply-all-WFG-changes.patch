-// mapping of mode to the corresponding index in pattern
-// UNUSED ZOH MODES are 0x13, 0x17, 0x1b, 0x1f -- return -2 for these
-static const int mode_to_pat[MAXMODES] = {	
-    3,	// 0x00
-    8,	// 0x01
-    0,	// 0x02
-    -1,-1,-1,
-    1,	// 0x06
-    -1,-1,-1,
-    2,	// 0x0a
-    -1,-1,-1,
-    4,	// 0x0e
-    -1,-1,-1,
-    5,	// 0x12
