+stbi_uc *stbi_gif_load_from_file   (FILE *f, int *x, int *y, int *comp, int req_comp)
+{
+   uint8 *u = 0;
+   stbi s;
+   stbi_gif g={0};
+   start_file(&s, f);
+
+   u = stbi_gif_load_next(&s, &g, comp, req_comp);
+   if (u == (void *) 1) u = 0;  // end of animated gif marker
+   if (u) {
+      *x = g.w;
+      *y = g.h;
+   }
+
+   return u;
+}
+#endif
