+        if (format == D3DFMT_A8) return 8*1;
+        if (format == D3DFMT_A8R3G3B2) return 8*2;
+        if (format == D3DFMT_X4R4G4B4) return 8*2;
+        if (format == D3DFMT_A2B10G10R10) return 8*4;
