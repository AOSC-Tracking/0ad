+    static int channelIndexFromName(const char* name)
+    {
+        char c = tolower(name[0]);
+        switch (c)
+        {
+        default:
+        case 'r':
+            return 0;
+        case 'g':
+            return 1;
+        case 'b':
+            return 2;
+        case 'a':
+            return 3;
+        }
+    }
+
+} // namespace
