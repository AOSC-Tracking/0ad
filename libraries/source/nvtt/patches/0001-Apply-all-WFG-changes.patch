+void FloatImage::convolve(const Kernel2 & k, uint c, WrapMode wm)
+{
+    AutoPtr<FloatImage> tmpImage(clone());
+
+    uint w = m_width;
+    uint h = m_height;
+    uint d = m_depth;
+
+    for (uint z = 0; z < d; z++)
+    {
+        for (uint y = 0; y < h; y++)
+        {
+            for (uint x = 0; x < w; x++)
+            {
+                pixel(c, x, y, 0) = tmpImage->applyKernelXY(&k, x, y, z, c, wm);
+            }
+        }
+    }
+}
