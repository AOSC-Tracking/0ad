+inline Color32 vector3_to_color(Vector3 v)
+{
+    Color32 color;
+    color.r = U8(ftoi_round(saturate(v.x) * 255));
+    color.g = U8(ftoi_round(saturate(v.y) * 255));
+    color.b = U8(ftoi_round(saturate(v.z) * 255));
+    color.a = 255;
+    return color;
+}
