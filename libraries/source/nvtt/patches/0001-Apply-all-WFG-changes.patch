+    Color32 * tmp = malloc<Color32>(count);
+    for (uint i = 0; i < count; i++) {
+        tmp[i].r = uint8(clamp(data[i + count*0], 0.0f, 1.0f) * 255);
+        tmp[i].g = uint8(clamp(data[i + count*1], 0.0f, 1.0f) * 255);
+        tmp[i].b = uint8(clamp(data[i + count*2], 0.0f, 1.0f) * 255);
