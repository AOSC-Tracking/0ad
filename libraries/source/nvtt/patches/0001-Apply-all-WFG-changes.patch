-static float fromSrgb(float f) {
-    if (f < 0.0f)           f = 0.0f;
-    else if (f < 0.04045f)  f = f / 12.92f;
-    else if (f <= 1.0f)     f = powf((f + 0.055f) / 1.055f, 2.4f);
-    else                    f = 1.0f;
-    return f;
-}
