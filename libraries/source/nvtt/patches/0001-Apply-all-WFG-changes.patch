+// Fill blocks that are smaller than (4,4) by wrapping indices.
+void ColorSet::wrapIndices()
+{
+    for (uint y = h; y < 4; y++)
+    {
+        uint base = (y % h) * w;
+        for (uint x = w; x < 4; x++)
+        {
+            indices[y*4+3] = indices[base + (x % w)];
+        }
+    }
+}
