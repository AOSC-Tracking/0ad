+bool nv::canMakeNextMipmap(uint w, uint h, uint d, uint min_size)
+{
+    if (min_size==1u) {  
+        if(w==1u && h==1u && d==1u) {
+            return false;
+        }
+    }
+    else if (((w <= min_size || h <= min_size) && d == 1u)) {
+        return false;
+    }
+
+    return true;
+}
+
+uint nv::countMipmaps(uint w)
+{
+    uint mipmap = 0;
+
+    while (w != 1) {
+        w = max(1U, w / 2);
+        mipmap++;
+    }
+
+    return mipmap + 1;
+}
+
+uint nv::countMipmaps(uint w, uint h, uint d)
+{
+    uint mipmap = 0;
+
+    while (w != 1 || h != 1 || d != 1) {
+        w = max(1U, w / 2);
+        h = max(1U, h / 2);
+        d = max(1U, d / 2);
+        mipmap++;
+    }
+
+    return mipmap + 1;
+}
+
+uint nv::countMipmapsWithMinSize(uint w, uint h, uint d, uint min_size)
+{
+    uint mipmap = 0;
+
+    while (canMakeNextMipmap(w, h, d, min_size)) {
+        w = max(1U, w / 2);
+        h = max(1U, h / 2);
+        d = max(1U, d / 2);
+        mipmap++;
+    }
+
+   return mipmap + 1;
+}
