-static float toSrgb(float f) {
-    if (isNan(f))               f = 0.0f;
-    else if (f <= 0.0f)         f = 0.0f;
-    else if (f <= 0.0031308f)   f = 12.92f * f;
-    else if (f <= 1.0f)         f = (powf(f, 0.41666f) * 1.055f) - 0.055f;
-    else                        f = 1.0f;
-    return f;
-}
